# ---- Running as a Shopify app (merchants install it) ----------------------
# From the app's page in the Partner Dashboard (Client ID / Client secret).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# The app's public URL. Shopify loads the settings page from it.
HOST=https://dailysmith-shopify.example.com
SCOPES=read_content,write_content

# ---- Running for one store with a custom app token (no OAuth, no UI) -----
# Create a custom app in the store's admin (Settings, Apps and sales
# channels, Develop apps), give it read_content and write_content, install
# it, and copy the Admin API access token.
#SHOPIFY_CUSTOM_APP_TOKEN=shpat_...
#SHOP=my-store.myshopify.com
#DAILYSMITH_PUBLIC_KEY=pk_...
#SHOPIFY_BLOG_HANDLE=news
#PUBLISH=1
#AUTHOR_NAME=

# ---- Both modes ------------------------------------------------------------
PORT=3000
DATABASE_PATH=./data/dailysmith.sqlite
DAILYSMITH_API_BASE=https://api.dailysmith.com
# 1 lets merchants type their own API base on the settings page. Leave unset
# on a hosted multi-tenant deployment: the process fetches whatever is stored.
#ALLOW_CUSTOM_API_BASE=1
SYNC_INTERVAL_MINUTES=60
RECONCILE_INTERVAL_MINUTES=1440
